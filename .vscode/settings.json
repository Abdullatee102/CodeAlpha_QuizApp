{
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "liveServer.settings.port": 5501,
  "files.associations": {
    "*.jsx": "javascriptreact",
    "*.js": "javascript"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.expo": true,
    "**/.git": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.expo/**": true
  }
}